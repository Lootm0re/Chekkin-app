rules_version = '2';

// Points, phone verification, check-ins, places and buddy check-ins are only
// written by Cloud Functions (admin access bypasses these rules). The app may
// only create its own profile and change its picture, avatar and their visibility.
service cloud.firestore {
  match /databases/{database}/documents {

    // avatar maps avatar_maker's part names to item ids; syncPublicProfile
    // also checks each value before showing it to others.
    function validPicture(data) {
      return (!('profilePictureUrl' in data) || (data.profilePictureUrl is string
               && data.profilePictureUrl.size() <= 2048))
        && (!('avatar' in data) || (data.avatar is map
               && data.avatar.keys().hasOnly([
                    'Accessory', 'AvatarBackground', 'AvatarEffect', 'AvatarEffectColor',
                    'Background', 'EyebrowType', 'EyeType', 'FacialHairColor',
                    'FacialHairType', 'HairColor', 'HairStyle', 'MouthType', 'Nose',
                    'OutfitColor', 'OutfitType', 'SkinColor'])))
        && (!('avatarHidden' in data) || data.avatarHidden is bool)
        && (!('profileImage' in data) || data.profileImage in ['avatar', 'photo']);
    }

    // Private: email, date of birth, phone, home location. Other users see
    // publicProfiles instead.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Sign-up (auth_screen.dart): starts with no points and an unverified phone.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'name', 'username', 'email', 'points', 'phoneVerified', 'dateOfBirth',
             'homeLatitude', 'homeLongitude', 'homeLastChanged', 'createdAt'])
        && request.resource.data.points == 0
        && request.resource.data.phoneVerified == false
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username == request.resource.data.username.lower()
        && request.resource.data.homeLastChanged == request.time
        && request.resource.data.createdAt == request.time;

      // Profile picture, avatar and whether others may see them
      // (profile_picture.dart, avatar_editor_screen.dart, main.dart).
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['profilePictureUrl', 'avatar', 'avatarHidden', 'profileImage'])
        && validPicture(request.resource.data);

      allow delete: if false;

      // Friends, written by the friend functions.
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }

      // Invites to friends' group check-ins, written by performCheckIn. The
      // user may delete one to decline it, or to clear an expired one.
      match /groupInvites/{groupId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
      }

      // placeCheckIns and codeAttempts: written by the check-in functions only.
      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // name, username, points and profile picture, copied from users/{uid} by
    // the syncPublicProfile function. Read by the leaderboard and the
    // username check at sign-up.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Business claims, written by requestBusinessClaim and
    // scripts/business-claims.js. Owners read their own for the Business
    // screen.
    match /businesses/{placeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow write: if false;
    }

    // Pending friend requests, written by sendFriendRequest. Either person
    // may delete one: the recipient to decline, the sender to cancel.
    match /friendRequests/{requestId} {
      allow read, delete: if request.auth != null
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Group check-ins, written by performCheckIn and joinGroup. Members and
    // invited friends can follow a group's progress.
    match /groups/{groupId} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.invited);
    }

    // businessSecrets, buddyCheckins, checkIns, places, phoneNumbers, and anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
