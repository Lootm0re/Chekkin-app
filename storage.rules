rules_version = '2';

// Profile photos live at profile_pictures/{uid}.jpg, and only their owner may
// read or change them here. Other users see a photo through the download URL
// that the publishProfilePicture function puts in publicProfiles/{uid}. Such
// URLs work without these rules, so the function replaces the URL's token
// whenever the owner hides their picture, and old copies stop working.
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_pictures/{fileName} {
      allow read, delete: if request.auth != null && fileName == request.auth.uid + '.jpg';

      allow create, update: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
  }
}
